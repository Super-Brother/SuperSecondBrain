# 服务器环境变量配置
# 复制为 .env.server 并修改

# LLM 配置（根据服务器上的LLM服务调整）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-9f58a77b83354d02a169b6fb8ceae507
LLM_MODEL=deepseek-v4-pro

# 模型路径（本地离线）
EMBEDDING_MODEL=/app/data/models/BAAI_bge-large-zh-v1.5
RERANKER_MODEL=/app/data/models/BAAI_bge-reranker-base

# Embedding 模型
#EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

 8猫，njklio.0p；/- # Reranker 模型
#RERANKER_MODEL=BAAI/bge-reranker-base

# Server Vault and index paths inside the Docker container.
# Host persistence comes from docker-compose.server.yml mounting ./data:/app/data.
VAULT_PATH=/app/data/vault
INDEX_DIR=/app/data/index

# Server sync is webhook/manual controlled; local filesystem watching is for development.
AUTO_SYNC=false
AUTO_SYNC_DEBOUNCE=5.0

# GitHub/GitLab webhook signature secret. Set this to a real random value on the server.
SYNC_WEBHOOK_SECRET=change-me-before-deploy
# Optional custom sync script inside the container. Leave empty to use git -C "$VAULT_PATH" pull.
SYNC_SCRIPT_PATH=

# When true, API note edits commit/pull --rebase/push back to the Vault Git remote.
VAULT_GIT_WRITEBACK=false

# SMTP 邮件配置（可选）
SMTP_HOST=smtp.126.com
SMTP_PORT=25
SMTP_USER=wenchaobaba@126.com
