# LLM 配置
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5:3b

# Embedding 模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Reranker 模型
RERANKER_MODEL=BAAI/bge-reranker-base

# Obsidian Vault 路径
VAULT_PATH=/Users/zhangwenchao/Library/Mobile Documents/iCloud~md~obsidian/Documents/文超的笔记本

# 索引存储目录
INDEX_DIR=data/index

# ============================================
# 企业级配置（可选）
# ============================================

# ---- 向量数据库后端（Docker 部署默认 Milvus）----
# VECTOR_STORE_BACKEND=milvus   # faiss | milvus
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_COLLECTION=enterprise_kb
# MILVUS_INDEX_TYPE=HNSW
# MILVUS_METRIC_TYPE=COSINE
# MILVUS_ENABLE_ACL=false

# ---- 数据脱敏 ----
# SANITIZE_QUERY=true      # Query 发送 LLM 前脱敏
# SANITIZE_DOCUMENT=false  # 文档入库前脱敏
# SANITIZE_ANSWER=true     # 答案返回前脱敏

# ---- 默认权限（文档元数据） ----
# DEFAULT_DEPARTMENT=default
# DEFAULT_ACCESS_LEVEL=0

# ---- SMTP 邮件配置（验证码发送）----
# 留空则进入开发模式，验证码打印到控制台
#
# Gmail 示例
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-email@gmail.com
#
# 126 邮箱示例
# SMTP_HOST=smtp.126.com
# SMTP_PORT=25
# SMTP_USER=yourname@126.com
# SMTP_PASSWORD=你的授权码
# SMTP_FROM=yourname@126.com

# ---- Redis 缓存 ----
# REDIS_URL=redis://localhost:6379/0

# ---- API 认证 ----
# API_KEY=your-secret-api-key
