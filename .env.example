# LLM 配置
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5:3b

# Embedding 模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Reranker 模型
RERANKER_MODEL=BAAI/bge-reranker-base

# Obsidian Vault 路径
VAULT_PATH=/Users/zhangwenchao/Library/Mobile Documents/iCloud~md~obsidian/Documents/文超的笔记本

# 索引存储目录
INDEX_DIR=data/index

# ============================================
# 企业级配置（可选）
# ============================================

# ---- 向量数据库后端（Docker 部署默认 Milvus）----
# VECTOR_STORE_BACKEND=milvus   # faiss | milvus
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_COLLECTION=enterprise_kb
# MILVUS_INDEX_TYPE=HNSW
# MILVUS_METRIC_TYPE=COSINE
# MILVUS_ENABLE_ACL=false

# ---- 数据脱敏 ----
# SANITIZE_QUERY=true      # Query 发送 LLM 前脱敏
# SANITIZE_DOCUMENT=false  # 文档入库前脱敏
# SANITIZE_ANSWER=true     # 答案返回前脱敏

# ---- 默认权限（文档元数据） ----
# DEFAULT_DEPARTMENT=default
# DEFAULT_ACCESS_LEVEL=0

# ---- SMTP 邮件配置（验证码发送）----
# 留空则进入开发模式，验证码打印到控制台
#
# Gmail 示例
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-email@gmail.com
#
# 126 邮箱示例
# SMTP_HOST=smtp.126.com
# SMTP_PORT=25
# SMTP_USER=yourname@126.com
# SMTP_PASSWORD=你的授权码
# SMTP_FROM=yourname@126.com

# ---- Redis 缓存 ----
# REDIS_URL=redis://localhost:6379/0

# ---- Vault 自动同步 ----
# AUTO_SYNC=true             # 是否启用自动同步
# AUTO_SYNC_DEBOUNCE=5.0     # 防抖等待秒数

# ---- 同步 Webhook（服务器部署推荐：Git + Webhook）----
# SYNC_WEBHOOK_SECRET=your-webhook-secret        # GitHub/GitLab webhook secret
# SYNC_SCRIPT_PATH=scripts/sync_vault.sh         # 可选：自定义同步脚本路径

# ---- API 认证 ----
# API_KEY=your-secret-api-key

# ============================================
# 日志与审计配置（可选）
# ============================================

# ---- 日志配置 ----
# LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text          # text | json
# LOG_MAX_BYTES=10485760   # 单个日志文件最大字节数（默认 10MB）
# LOG_BACKUP_COUNT=5       # 保留备份数量

# ---- LLM 超时（秒）----
# LLM_TIMEOUT=30           # 同步调用超时
# LLM_STREAM_TIMEOUT=60    # 流式调用超时

# ---- 熔断器配置 ----
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5    # 连续失败阈值
# CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60    # 恢复超时秒数

# ---- slowapi 限流配置 ----
# RATE_LIMIT_CHAT=10/minute
# RATE_LIMIT_STREAM=10/minute
# RATE_LIMIT_SEND_CODE=3/minute
