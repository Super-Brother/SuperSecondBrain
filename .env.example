# LLM 配置
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5:3b

# Embedding 模型
# 支持三种格式：
#   1. HuggingFace 模型名（如 BAAI/bge-large-zh-v1.5）——首次自动下载
#   2. 本地绝对路径（如 /opt/models/bge-large-zh-v1.5）
#   3. 留空或保持默认值——自动优先使用项目内 models/bge-large-zh-v1.5/
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 本地向量化稳定性配置；Apple Silicon 如需试用 MPS，可改 EMBEDDING_DEVICE=mps
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Reranker 模型（同理，优先本地 models/bge-reranker-base/）
RERANKER_MODEL=BAAI/bge-reranker-base

# Obsidian Vault 路径
VAULT_PATH=/Users/zhangwenchao/Library/Mobile Documents/iCloud~md~obsidian/Documents/文超的笔记本

# 索引存储目录
INDEX_DIR=data/index

# 服务器部署推荐：
# VAULT_PATH=/app/data/vault
# INDEX_DIR=/app/data/index
# AUTO_SYNC=false
# SYNC_WEBHOOK_SECRET=your-webhook-secret
# SYNC_SCRIPT_PATH=
# VAULT_GIT_WRITEBACK=false

# 飞书自建应用机器人（长连接优先，默认关闭）
# 启动方式：python scripts/feishu_ws_worker.py
# FEISHU_BOT_ENABLED=false
# FEISHU_WS_AUTOSTART=false # true 时随 FastAPI 服务启动飞书长连接
# FEISHU_LOG_LEVEL=INFO
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN= # 仅 HTTP 回调模式需要；长连接模式可留空
# FEISHU_ENCRYPT_KEY=
# FEISHU_ALLOWED_OPEN_IDS=

# ============================================
# 企业级配置（可选）
# ============================================

# ---- 向量数据库后端（Docker 部署默认 Milvus）----
# VECTOR_STORE_BACKEND=milvus   # faiss | milvus
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_COLLECTION=enterprise_kb
# MILVUS_INDEX_TYPE=HNSW
# MILVUS_METRIC_TYPE=COSINE
# MILVUS_ENABLE_ACL=false

# ---- 数据脱敏 ----
# SANITIZE_QUERY=true      # Query 发送 LLM 前脱敏
# SANITIZE_DOCUMENT=false  # 文档入库前脱敏
# SANITIZE_ANSWER=true     # 答案返回前脱敏

# ---- 默认权限（文档元数据） ----
# DEFAULT_DEPARTMENT=default
# DEFAULT_ACCESS_LEVEL=0

# ---- SMTP 邮件配置（验证码发送）----
# 留空则进入开发模式，验证码打印到控制台
#
# Gmail 示例
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-email@gmail.com
#
# 126 邮箱示例
# SMTP_HOST=smtp.126.com
# SMTP_PORT=25
# SMTP_USER=yourname@126.com
# SMTP_PASSWORD=你的授权码
# SMTP_FROM=yourname@126.com

# ---- Redis 缓存 ----
# REDIS_URL=redis://localhost:6379/0

# ---- Vault 自动同步 ----
# AUTO_SYNC=true             # 是否启用自动同步
# AUTO_SYNC_DEBOUNCE=5.0     # 防抖等待秒数

# ---- 同步 Webhook（服务器部署推荐：Git + Webhook）----
# SYNC_WEBHOOK_SECRET=your-webhook-secret        # GitHub/GitLab webhook secret
# SYNC_SCRIPT_PATH=scripts/sync_vault.sh         # 可选：自定义同步脚本路径

# ---- API 认证 ----
# API_KEY=your-secret-api-key

# ============================================
# 日志与审计配置（可选）
# ============================================

# ---- 日志配置 ----
# LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text          # text | json
# LOG_MAX_BYTES=10485760   # 单个日志文件最大字节数（默认 10MB）
# LOG_BACKUP_COUNT=5       # 保留备份数量

# ---- LLM 超时（秒）----
# LLM_TIMEOUT=30           # 同步调用超时
# LLM_STREAM_TIMEOUT=60    # 流式调用超时

# ---- 熔断器配置 ----
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5              # 通用连续失败阈值
# CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60              # 通用恢复超时秒数
# CIRCUIT_BREAKER_SUMMARIZER_FAILURE_THRESHOLD=3   # 摘要熔断器失败阈值（更保守）
# CIRCUIT_BREAKER_SUMMARIZER_RECOVERY_TIMEOUT=30   # 摘要熔断器恢复超时（更短）

# ---- slowapi 限流配置 ----
# RATE_LIMIT_CHAT=10/minute
# RATE_LIMIT_STREAM=10/minute
# RATE_LIMIT_SEND_CODE=3/minute

# ---- Metrics 告警阈值 ----
# METRICS_ALERT_P95_LATENCY_MS=5000      # P95 延迟告警阈值（毫秒），默认 5000
# METRICS_ALERT_P99_LATENCY_MS=10000     # P99 延迟告警阈值（毫秒），默认 10000
# METRICS_ALERT_ERROR_RATE=0.05          # 错误率告警阈值（0-1），默认 0.05 = 5%
